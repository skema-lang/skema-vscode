{
  "name": "skemavscode",
  "displayName": "skema",
  "description": "Editing support and a live ER diagram for the skema modelling DSL",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "skema",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/skema-language/skema-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.skema"
  ],
  "contributes": {
    "languages": [
      {
        "id": "skema",
        "aliases": [
          "skema"
        ],
        "extensions": [
          ".skema"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "skema.showDiagram",
        "title": "skema: Show diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "skema.restartServer",
        "title": "skema: Restart language server"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "skema.showDiagram",
          "when": "resourceLangId == skema",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "skema",
      "properties": {
        "skema.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `skema-lsp` binary. Overrides the one bundled with the extension - the way to run the extension against a locally built server (`cargo build -p skema-lsp`). Empty means: use the bundled binary, or `skema-lsp` from `PATH` if none was bundled.",
          "scope": "machine-overridable"
        },
        "skema.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VSCode and the skema language server."
        },
        "skema.diagram.edgeRouting": {
          "type": "string",
          "enum": [
            "bezier",
            "smoothstep",
            "step",
            "straight"
          ],
          "default": "smoothstep",
          "description": "How relationship lines are drawn in the diagram."
        },
        "skema.diagram.snapToGrid": {
          "type": "boolean",
          "default": false,
          "description": "Snap a dragged table to the grid."
        },
        "skema.diagram.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "description": "Grid spacing used when snapping is on."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "sync:types": "node scripts/sync-types.mjs",
    "fetch:server": "node scripts/fetch-server.mjs",
    "test": "node esbuild.mjs --tests && node --test dist/test/*.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vscode-languageclient": "^9.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "skemaServer": {
    "comment": "Which skema-lsp release `npm run fetch:server` bundles: this extension's own `version` above, tag-prefixed. skema, skema-vscode and skema-editor move in lockstep by convention, so \"skema-vscode 0.2.0\" always means skema-lsp v0.2.0 - no separate version to keep in sync here. Override with SKEMA_SERVER_VERSION to pull a different one on purpose.",
    "project": "skema-language/skema",
    "registry": "https://gitlab.com"
  }
}
