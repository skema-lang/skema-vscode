{
  "name": "skemavscode",
  "displayName": "skema",
  "description": "Editing support and a live ER diagram for the skema modelling DSL",
  "version": "0.5.0-rc.1",
  "private": true,
  "license": "MIT",
  "publisher": "skema",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/skema-language/skema-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.skema",
    "onUri"
  ],
  "contributes": {
    "languages": [
      {
        "id": "skema",
        "aliases": [
          "skema"
        ],
        "extensions": [
          ".skema"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "skema.showDiagram",
        "title": "skema: Show diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "skema.showDocumentation",
        "title": "skema: Show documentation",
        "icon": "$(book)"
      },
      {
        "command": "skema.exportDocumentation",
        "title": "skema: Export documentation as Markdown"
      },
      {
        "command": "skema.restartServer",
        "title": "skema: Restart language server"
      },
      {
        "command": "skema.collab.startSession",
        "title": "skema: Start collaboration session"
      },
      {
        "command": "skema.collab.invite",
        "title": "skema: Invite someone to the collaboration session"
      },
      {
        "command": "skema.collab.completeSession",
        "title": "skema: Complete collaboration session"
      },
      {
        "command": "skema.collab.joinSession",
        "title": "skema: Join collaboration session"
      },
      {
        "command": "skema.collab.endSession",
        "title": "skema: End collaboration session"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "skema.showDiagram",
          "when": "resourceLangId == skema",
          "group": "navigation"
        },
        {
          "command": "skema.showDocumentation",
          "when": "resourceLangId == skema",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "skema.collab.invite",
          "when": "skema.collab.hosting"
        }
      ]
    },
    "configuration": {
      "title": "skema",
      "properties": {
        "skema.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `skema-lsp` binary. Overrides the one bundled with the extension - the way to run the extension against a locally built server (`cargo build -p skema-lsp`). Empty means: use the bundled binary, or `skema-lsp` from `PATH` if none was bundled.",
          "scope": "machine-overridable"
        },
        "skema.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between VSCode and the skema language server."
        },
        "skema.diagram.edgeRouting": {
          "type": "string",
          "enum": [
            "bezier",
            "smoothstep",
            "step",
            "straight"
          ],
          "default": "smoothstep",
          "description": "How relationship lines are drawn in the diagram."
        },
        "skema.diagram.snapToGrid": {
          "type": "boolean",
          "default": false,
          "description": "Snap a dragged table to the grid."
        },
        "skema.diagram.gridSize": {
          "type": "number",
          "default": 16,
          "minimum": 4,
          "description": "Grid spacing used when snapping is on."
        },
        "skema.collab.editorUrl": {
          "type": "string",
          "format": "uri",
          "default": "https://skema-language.gitlab.io/skema-editor/",
          "scope": "application",
          "markdownDescription": "The `skema-editor` instance collaboration invites and answers are linked to. Application-scoped so a workspace cannot redirect a session-granting link to another site."
        }
      }
    },
    "configurationDefaults": {
      "[skema]": {
        "editor.showFoldingControls": "always"
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "fetch:server": "node scripts/fetch-server.mjs",
    "test": "node esbuild.mjs --tests && node --test dist/test/*.test.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@skema/collab-protocol": "0.3.0",
    "@skema/diagram": "0.3.0",
    "@skema/docs": "0.3.0",
    "@skema/model": "0.4.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vscode-languageclient": "^9.0.1",
    "werift": "^0.24.4",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "skemaServer": {
    "comment": "Which skema-lsp release `npm run fetch:server` bundles: v<the @skema/model dependency's version>, since both come from the same skema-lang release. Override with SKEMA_SERVER_VERSION to pull a different one on purpose.",
    "project": "skema-language/skema",
    "registry": "https://gitlab.com"
  }
}
